# 环境变量样例：Copy-Item .env.example .env 后按需修改（.env 已在 .gitignore 中）。
# 程序本身不读取 .env；`compose.yaml` 会自动读取同目录 .env 做变量替换，
# 直接部署裸进程时仍请由 shell、systemd 或容器运行时注入。
# 配置项说明见 docs/ARCHITECTURE.md 附录 A。

# ---------------------------------------------------------------------------
# 本地编排（compose.yaml）：复制为 .env 后 `docker compose up -d --build` 即可
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=gleannote
# 服务端镜像：compose 首次会按 Dockerfile 构建并打上该标签
GN_IMAGE=gleannote:local
# 宿主入口端口（绑定 0.0.0.0，需由防火墙/安全组限制访问来源）
GN_HTTP_PORT=8080

# PostgreSQL（compose 内网地址为 postgres:5432）
POSTGRES_USER=gleannote
POSTGRES_PASSWORD=gleannote-dev-secret
POSTGRES_DB=gleannote
POSTGRES_PORT=5432

# Redis（appendonly 持久化，compose 内网地址为 redis:6379）
REDIS_PORT=6379

# MinIO（S3 接口 9000 / 控制台 9001；服务端凭据由下面两项派生）
MINIO_ROOT_USER=gleannote
MINIO_ROOT_PASSWORD=gleannote-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 国内网络可改用华为云镜像（拉取后重命名为官方名称再填到这里）：
# MINIO_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/quay.io/minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-07-23T15-54-02Z

# 运行环境：dev / staging / prod
# 非 dev（staging / prod）下任何提供者取值为 fake 都会启动失败
GN_ENV=dev
# 运行模式：all（API + Worker）/ api（仅 HTTP）/ worker（仅转换 Worker）
GN_MODE=all
# 裸进程运行时监听地址；compose 内固定为 0.0.0.0:8080，不受此行影响
GN_HTTP_ADDR=0.0.0.0:8080
GN_LOG_LEVEL=info

# 分享链接对外地址前缀，生成为 {base}/s/{token}；不能为空
# 本地联调用 http://127.0.0.1:8080，生产改为真实域名（https）
GN_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 付费能力提供者：视觉支持 fake/deepseek，邮件当前只支持 fake，对象存储支持 minio/s3/fake
GN_VISION_PROVIDER=fake
GN_MAILER_PROVIDER=fake
GN_OBJECT_STORE_PROVIDER=minio

# 视觉识别（deepseek = OpenAI Chat Completions 兼容的多模态接口）
# 选择 deepseek 时 GN_VISION_API_KEY 必填；.env 已被 gitignore，不会入库
# BaseURL / Model 留空即用内置默认：https://api.deepseek.com 与 deepseek-flash；
# 也可指向任意兼容 /chat/completions 且支持图片输入的服务
GN_VISION_API_KEY=
GN_VISION_BASE_URL=
GN_VISION_MODEL=
# 单次模型调用超时；整篇转换仍有用例层 5 分钟总上限
GN_VISION_REQUEST_TIMEOUT=2m

# 对象存储（本地 MinIO 容器由 compose.yaml 自动拉起）
GN_S3_ENDPOINT=127.0.0.1:9000
GN_S3_BUCKET=gleannote-private
GN_S3_ACCESS_KEY=gleannote
GN_S3_SECRET_KEY=gleannote-dev-secret
GN_S3_REGION=us-east-1
GN_S3_USE_SSL=false

# 认证密钥：验证码 HMAC 至少 32 字节；JWT 使用 Ed25519，需 base64 编码的 32 字节种子
# prod/staging 必填，dev 留空则使用进程内随机种子（重启后旧令牌失效）
GN_HMAC_SECRET=dev-only-hmac-secret-replace-me-32bytes
GN_JWT_PRIVATE_KEY=

# Fake 视觉故障演练（开发联调用）
# GN_FAKE_VISION_LATENCY 例：2s / 500ms
GN_FAKE_VISION_LATENCY=0s
# GN_FAKE_VISION_FAILURE 取值：unavailable / unreadable / unsupported / 空
GN_FAKE_VISION_FAILURE=
# 开发态邮件日志默认脱敏；本地手工读验证码时改为 true（仅限本地，勿用于共享环境）
GN_FAKE_MAIL_REVEAL_CODE=false

# 业务持久化：memory（单元测试/离线开发，进程退出即丢失）/ postgres（运行态）
GN_REPOSITORY_PROVIDER=memory
# 选择 postgres 时必填；连接池上限默认为 8
# GN_DATABASE_URL=postgres://gleannote:gleannote-dev-secret@127.0.0.1:5432/gleannote?sslmode=disable
GN_DATABASE_MAX_CONNS=8

# 缓存与异步能力：memory（单实例）/ redis（多实例共享限流、幂等、黑名单与转换队列）
GN_CACHE_PROVIDER=memory
# 选择 redis 时必填
# GN_REDIS_URL=redis://127.0.0.1:6379/0

# 以下为目标配置，真实供应商接入后启用
# GN_SMTP_HOST=
# GN_SMTP_PORT=
# GN_SMTP_USERNAME=
# GN_SMTP_PASSWORD=
